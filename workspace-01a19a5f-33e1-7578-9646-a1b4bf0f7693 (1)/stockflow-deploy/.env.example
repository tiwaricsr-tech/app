# ─────────────────────────────────────────────────────────────────────────────
#  StockFlow environment template
#  Copy to .env and fill in. Nothing here is required for local development:
#  with no .env the app runs on embedded SQLite and seeds itself automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4173
NODE_ENV=development

# Signs session JWTs (12 h). MUST be set in production — the server refuses to
# boot with the built-in development secret when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# openssl rand -base64 48

# ── Database ─────────────────────────────────────────────────────────────────
# Leave BLANK to use the embedded SQLite file at data/stockflow.db (zero setup).
# Set it to use PostgreSQL / Supabase — all features and tests are identical.
#
# Supabase → Project Settings → Database → Connection string → URI
# Use the *session pooler* (port 5432) for a long-running server, or the
# *transaction pooler* (port 6543) for serverless functions.
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
DATABASE_URL=

# Connection pool ceiling. Keep low (1-3) on serverless platforms.
PG_POOL_MAX=10
# Milliseconds to wait for a free connection before failing the request.
PG_CONNECT_TIMEOUT_MS=10000

# ── Preview / iframe embedding ───────────────────────────────────────────────
# The app is served inside a sandboxed iframe (opaque origin). These default to
# permissive so previews work. Lock them down for a public deployment:
#
#   CORS_ORIGINS=https://app.example.com
#   FRAME_ANCESTORS=https://app.example.com     # set → emits CSP frame-ancestors
#
CORS_ORIGINS=*
FRAME_ANCESTORS=

# ── Business settings ────────────────────────────────────────────────────────
# Minutes to shift timestamps when bucketing "today"/"this month" in reports.
# 330 = UTC+05:30 (IST).
DATE_SHIFT_MINUTES=330
COMPANY_NAME=StockFlow
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GSTIN=
